# For Next.js/Vercel local development: copy this file to .env.local.
# On Vercel, add these through Project Settings > Environment Variables.
# Required for accounts, sessions, watchlists, and diary storage:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Optional movie data, password-reset emails, and social sign-in:
TMDB_READ_ACCESS_TOKEN=
RESEND_API_KEY=
AUTH_FROM_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
